# Copy this file to .env and fill in the values.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# In production, e.g.:
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=easyian.com,www.easyian.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://easyian.com,https://www.easyian.com

# Public URL used for canonical tags, sitemap and social previews
SITE_URL=http://127.0.0.1:8000

# Database (default SQLite). For PostgreSQL:
# DB_ENGINE=postgres
# DB_NAME=easyian
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Email for lead notifications (set the address in Admin → Site settings)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Easyian Website <no-reply@easyian.com>

# Lead form hidden captcha tuning
LEAD_MIN_SUBMIT_SECONDS=3
LEAD_RATE_LIMIT_PER_HOUR=5
LEAD_MAX_LINKS_IN_MESSAGE=2
# Optional extra layer: Cloudflare Turnstile (invisible). Leave empty to disable.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
